[Unit]
Description=Owner-local Starslab HTX spot execution
After=network-online.target starslab-runner-egress.service
Wants=network-online.target starslab-runner-egress.service

[Service]
ExecStart=%h/.local/bin/starslab-runner run
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/starslab-runner

[Install]
WantedBy=default.target
