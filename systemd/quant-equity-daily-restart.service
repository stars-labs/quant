[Unit]
# Daily fresh IB session for quant-equity. After the Gateway's nightly auto-restart
# (23:59 ET) the node's socket can stay half-open: no error, no disconnect, no bars
# (observed 2026-09-26 23:33 → 09-27, ESTAB socket with ~14 h since last receive), which
# quant-equity-watchdog (greps "Client failed to initialize") cannot see. Restarting is
# harmless since the strategy keeps positions on stop (flatten_on_stop=False), re-claims
# them + their GTC stop (external_order_claims) and re-warms indicators from history.
#
# Install: cp systemd/quant-equity-daily-restart.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now quant-equity-daily-restart.timer
Description=Restart quant-equity once a day after the IB Gateway's nightly restart

[Service]
Type=oneshot
Environment=PATH=/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/run/current-system/sw/bin/systemctl --user restart quant-equity.service
