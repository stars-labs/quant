[Unit]
Description=Owner-controlled HTX allowlisted HTTPS egress
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/run/current-system/sw/bin/ssh -N -D 127.0.0.1:11080 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 oracle-arm-002
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
